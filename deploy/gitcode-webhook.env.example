# Copy to /etc/myblog/gitcode-webhook.env and replace the example secret.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9001
WEBHOOK_SECRET=replace-with-a-long-random-secret
DEPLOY_BRANCH=codex/sakura-template-layout
DEPLOY_SCRIPT=/home/deploy/my-blog/scripts/deploy.sh
DEPLOY_LOG=/var/log/myblog/deploy.log
REPO_DIR=/home/deploy/my-blog
DEPLOY_REMOTE=origin
DEPLOY_DIR=/var/www/myblog/html
